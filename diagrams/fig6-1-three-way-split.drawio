        <mxCell id="param-body" value="min_interactions &amp;nbsp;= 16&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;（用户最少交互数）&#xa;val_position &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= -5&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;（验证物品位于倒数第 5 位）&#xa;test_start &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= -3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;（测试物品从倒数第 3 位开始）&#xa;test_count &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;（每用户 3 个测试物品）&#xa;like_threshold &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 4.0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;（测试物品评分 ≥ 4.0）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;fontFamily=Courier New;spacingLeft=5;spacingTop=5;" vertex="1" parent="1">
