      pageWidth="680" pageHeight="720" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="t" value="图5-2 NCF模型结构 (MLP Architecture)" style="text;html=1;fontSize=14;fontColor=#1A1A1A;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="6" width="340" height="24" as="geometry"/></mxCell>

        <!-- ====== INPUT LAYER ====== -->
        <mxCell id="g_in" value="Input Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#CCCCCC;strokeWidth=1.0;dashed=1;fontSize=9;fontColor=#999999;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="620" height="80" as="geometry"/></mxCell>
        <mxCell id="n_uid" value="&lt;b&gt;User ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;int, 0 ~ N_users-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.2;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="100" y="58" width="165" height="42" as="geometry"/></mxCell>
        <mxCell id="n_iid" value="&lt;b&gt;Item ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;int, 0 ~ M_items-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.2;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="415" y="58" width="165" height="42" as="geometry"/></mxCell>

        <!-- Input→Emb arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_uid" target="n_uemb">
          <mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_iid" target="n_iemb">
          <mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== EMBEDDING LAYER ====== -->
        <mxCell id="g_emb" value="Embedding Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#CCCCCC;strokeWidth=1.0;dashed=1;fontSize=9;fontColor=#999999;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="135" width="620" height="80" as="geometry"/></mxCell>
        <mxCell id="n_uemb" value="&lt;b&gt;User Embedding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;nn.Embedding(N, d)  d=32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="100" y="153" width="165" height="44" as="geometry"/></mxCell>
        <mxCell id="n_iemb" value="&lt;b&gt;Item Embedding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;nn.Embedding(M, d)  d=32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="415" y="153" width="165" height="44" as="geometry"/></mxCell>

        <!-- Emb→Concat arrows -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_uemb" target="n_cat">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="183" y="230"/><mxPoint x="200" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="a3_label" value="&lt;font style=&quot;font-size:8;color:#6C8EBF&quot;&gt;[B, 32]&lt;/font&gt;" style="text;html=1;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="155" y="218" width="40" height="14" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_iemb" target="n_cat">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="498" y="230"/><mxPoint x="480" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="a4_label" value="&lt;font style=&quot;font-size:8;color:#6C8EBF&quot;&gt;[B, 32]&lt;/font&gt;" style="text;html=1;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="218" width="40" height="14" as="geometry"/></mxCell>

        <!-- ====== CONCAT ====== -->
        <mxCell id="n_cat" value="&lt;b&gt;Concatenate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;torch.cat([u, i], dim=-1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="230" y="240" width="220" height="46" as="geometry"/></mxCell>
        <!-- dim annotation under concat -->
        <mxCell id="cat_dim" value="&lt;font style=&quot;font-size:9;color:#9673A6&quot;&gt;output shape: [B, 64]&lt;/font&gt;" style="text;html=1;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="286" width="120" height="14" as="geometry"/></mxCell>

        <!-- Cat→FC1 arrow -->
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#9673A6;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_cat" target="n_fc1">
          <mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== MLP LAYER ====== -->
        <mxCell id="g_mlp" value="MLP Interaction Layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#CCCCCC;strokeWidth=1.0;dashed=1;fontSize=9;fontColor=#999999;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="620" height="170" as="geometry"/></mxCell>

        <!-- FC1: 64→64 + ReLU -->
        <mxCell id="n_fc1" value="&lt;b&gt;FC Layer 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;Linear(64, 64) + ReLU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="230" y="330" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="fc1_dim" value="&lt;font style=&quot;font-size:8;color:#6C8EBF&quot;&gt;[B, 64] → [B, 64]&lt;/font&gt;" style="text;html=1;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="374" width="100" height="12" as="geometry"/></mxCell>

        <!-- FC1→FC2 -->
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_fc1" target="n_fc2">
          <mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- FC2: 64→32 + ReLU -->
        <mxCell id="n_fc2" value="&lt;b&gt;FC Layer 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;Linear(64, 32) + ReLU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="230" y="395" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="fc2_dim" value="&lt;font style=&quot;font-size:8;color:#6C8EBF&quot;&gt;[B, 64] → [B, 32]&lt;/font&gt;" style="text;html=1;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="439" width="100" height="12" as="geometry"/></mxCell>

        <!-- FC2→FC3 -->
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_fc2" target="n_fc3">
          <mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== OUTPUT LAYER ====== -->
        <mxCell id="g_out" value="Output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#CCCCCC;strokeWidth=1.0;dashed=1;fontSize=9;fontColor=#999999;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="500" width="620" height="110" as="geometry"/></mxCell>

        <!-- FC3: 32→1 -->
        <mxCell id="n_fc3" value="&lt;b&gt;FC Layer 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;Linear(32, 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="240" y="518" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="fc3_dim" value="&lt;font style=&quot;font-size:8;color:#D6B656&quot;&gt;[B, 32] → [B, 1]&lt;/font&gt;" style="text;html=1;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="558" width="100" height="12" as="geometry"/></mxCell>

        <!-- FC3→Sigmoid -->
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#D6B656;strokeWidth=1.0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_fc3" target="n_sig">
          <mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Sigmoid + Score -->
        <mxCell id="n_sig" value="&lt;b&gt;Sigmoid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9;color:#888888&quot;&gt;σ(x) = 1/(1+e⁻ˣ)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.4;arcSize=10;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="240" y="578" width="200" height="40" as="geometry"/></mxCell>

        <!-- ====== TRAINING SIDE-NOTE ====== -->
        <mxCell id="note_tr" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE8F5;strokeColor=#8B7EC4;strokeWidth=1.0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="625" width="620" height="52" as="geometry"/></mxCell>
        <mxCell id="note_txt" value="&lt;b&gt;Training&lt;/b&gt;&amp;nbsp; BCEWithLogitsLoss &amp;nbsp;|&amp;nbsp; Adam (lr=1e-3) &amp;nbsp;|&amp;nbsp; Negative Sampling (neg_ratio=1, max_retry=48)&amp;nbsp;|&amp;nbsp; Early Stopping (patience=3, monitor=NDCG@10)" style="text;html=1;fontSize=9;fontColor=#6B50B0;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="634" width="600" height="36" as="geometry"/></mxCell>

      </root>
